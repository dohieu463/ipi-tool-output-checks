OPENAI_API_KEY=sk-...
# OpenAI-compatible base URL. Leave empty for api.openai.com.
# OpenCode Go gateway: https://opencode.ai/inference/go/openai/v1
OPENAI_BASE_URL=
# Agent model, and an optional separate model for llm_detector / llm_sanitizer.
OPENAI_MODEL=gpt-4o-mini-2024-07-18
CHECKER_MODEL=
# Only for OpenAI-compatible gateways that route on it (OpenCode Go).
OPENCODE_SESSION_ID=
# Client robustness for long unattended runs.
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=8
